{
  "name": "Audit Trail Ledger (call me from any workflow)",
  "nodes": [
    {
      "parameters": {},
      "name": "Log An Event (sub-workflow trigger)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -220,
        -100
      ],
      "id": "node-0000"
    },
    {
      "parameters": {
        "jsCode": "// Normalize whatever the calling workflow sends into one ledger row\nconst e = $input.first().json;\nreturn [{ json: {\n  ts: new Date().toISOString(),\n  eventType: e.eventType || 'unspecified',\n  actor: e.actor || 'automation',\n  target: e.target || '',\n  source: e.source || 'unknown-workflow',\n  details: typeof e.details === 'string' ? e.details : JSON.stringify(e.details || {}),\n  executionId: $execution.id\n} }];"
      },
      "name": "Normalize + Timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -100
      ],
      "id": "node-0001"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "https://docs.google.com/spreadsheets/d/REPLACE_ME"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Ledger"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {}
        },
        "options": {}
      },
      "name": "Append To Ledger (Google Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        -100
      ],
      "id": "node-0002"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 16 * * 5"
            }
          ]
        }
      },
      "name": "Fridays 4 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -220,
        140
      ],
      "id": "node-0003"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "https://docs.google.com/spreadsheets/d/REPLACE_ME"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Ledger"
        },
        "options": {}
      },
      "name": "Read Ledger",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        0,
        140
      ],
      "id": "node-0004"
    },
    {
      "parameters": {
        "jsCode": "const weekAgo = Date.now() - 7 * 86400e3;\nconst rows = $input.all().map(i => i.json).filter(r => new Date(r.ts).getTime() > weekAgo);\nconst by = (k) => rows.reduce((m, r) => (m[r[k]] = (m[r[k]] || 0) + 1, m), {});\nconst fmt = (o) => Object.entries(o).sort((a, b) => b[1] - a[1]).map(([k, v]) => '  ' + k + ': ' + v).join('\\n');\nlet body = 'Weekly evidence digest (' + rows.length + ' logged events):\\n\\nBy event type:\\n' + fmt(by('eventType')) + '\\n\\nBy source workflow:\\n' + fmt(by('source')) + '\\n\\nBy actor:\\n' + fmt(by('actor')) + '\\n\\nEvery row carries timestamp + execution id, so any line traces to a full execution log in n8n.\\nWhy this exists: when the audit request comes, the answer is a filter on one sheet, not a week of reconstruction.';\nreturn [{ json: { subject: 'Audit ledger: ' + rows.length + ' events this week', body } }];"
      },
      "name": "Summarize Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        140
      ],
      "id": "node-0005"
    },
    {
      "parameters": {
        "sendTo": "roblesemilio24@gmail.com",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "name": "Weekly Evidence Digest",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        440,
        140
      ],
      "id": "node-0006"
    }
  ],
  "connections": {
    "Log An Event (sub-workflow trigger)": {
      "main": [
        [
          {
            "node": "Normalize + Timestamp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize + Timestamp": {
      "main": [
        [
          {
