    {
      "parameters": {
        "jsCode": "const OKTA_BASE = 'https://dev-REPLACE-ME.okta.com'; // your Okta dev tenant\nconst JAMF_BASE = 'https://REPLACE-ME.jamfcloud.com'; // your Jamf instance\n// Birthright access by department - okta-as-code pattern, evaluated at event time\nconst BIRTHRIGHT = { engineering: 'Eng-Tools', sales: 'GTM-Apps', support: 'Support-Stack' };\nconst e = $input.first().json.body.employee;\nconst dept = String(e.department || '').toLowerCase();\nreturn [{ json: {\n  oktaBase: OKTA_BASE, jamfBase: JAMF_BASE, employee: e, serial: e.serial || '',\n  birthrightGroup: BIRTHRIGHT[dept] ?? 'Everyone-Base',\n  profile: { firstName: e.firstName, lastName: e.lastName, email: e.email, login: e.email, title: e.title || '', department: e.department || '' }\n} }];"
      },
      "name": "Joiner: Build Profile + Groups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        -170
      ],
      "id": "node-0002"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.oktaBase }}/api/v1/users?activate=true",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ profile: $json.profile }) }}"
      },
      "name": "Create Okta User",
